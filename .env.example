# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and is never copied into the Docker image —
# Compose reads it from the host at container start (see compose.yaml).

# MongoDB connection string.
# Atlas:            mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ricemania
# Mongo on Windows: mongodb://host.docker.internal:27017/ricemania
# Mongo in Compose: mongodb://mongo:27017/ricemania
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ricemania

# Secret used to sign auth tokens. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string
